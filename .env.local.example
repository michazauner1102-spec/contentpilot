# =============================================================================
# Öffentliche Demo / GitHub-Klon — nur Mock (empfohlen)
# =============================================================================
NEXT_PUBLIC_DEMO_MODE=true
FORCE_MOCK_ONLY=true
INSIGHTS_MODE=mock

# =============================================================================
# Optional: echte KI lokal (Mock oben deaktivieren)
# =============================================================================
# FORCE_MOCK_ONLY entfernen oder =false, NEXT_PUBLIC_DEMO_MODE=false
#
# Essentiell: genau EIN LLM — nur Provider + passenden Key setzen:
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
#
# Alternativen (jeweils nur EIN Key):
# LLM_PROVIDER=gemini
# GOOGLE_GENERATIVE_AI_API_KEY=
#
# LLM_PROVIDER=openai
# OPENAI_API_KEY=
#
# Optional: LLM_MODEL=… (sonst Default pro Provider)

# --- Optional: Web-Recherche (Firecrawl, Perplexity, Tavily) ---
# Ohne Keys: Auto/Fallback — das LLM arbeitet mit Allgemeinwissen weiter.
# RESEARCH_WEB_PROVIDER=auto
# TAVILY_API_KEY=
# PERPLEXITY_API_KEY=
# FIRECRAWL_API_KEY=
# „Gemini Research“ / „Claude Research“ in der UI = derselbe Key wie dein LLM
# (gemini bzw. anthropic), kein zweites Modell nötig.

# --- Referenz-Videos (Multi-Plattform) ---
# REFERENCE_PLATFORMS=youtube,instagram,tiktok,linkedin
# YOUTUBE_API_KEY=
# META_ACCESS_TOKEN=
# TIKTOK_ACCESS_TOKEN=
# LINKEDIN_ACCESS_TOKEN=

# --- Notion (optional) ---
# NOTION_TOKEN=
# NOTION_DATABASE_ID=
