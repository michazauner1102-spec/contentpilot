# =============================================================================
# ContentPilot — lokale Konfiguration
#
# Kopieren:  cp .env.local.example .env.local
# .env.local ist in .gitignore — Keys landen NIE auf GitHub.
# =============================================================================

# --- Login / Sessions -------------------------------------------------------
# Pflicht in Produktion, lokal optional (dann Dev-Fallback).
# Erzeugen:  openssl rand -base64 32
# SESSION_SECRET=

# --- Datenbank --------------------------------------------------------------
# Ohne DATABASE_URL: Accounts und Pläne liegen lokal in .data/contentpilot.json
# Mit DATABASE_URL:  Postgres (Render, Neon, Supabase) — Tabellen werden automatisch angelegt.
# DATABASE_URL=postgres://user:pass@host:5432/contentpilot

# =============================================================================
# KI — genau EINEN Key eintragen, das reicht
# =============================================================================
# Provider und Mock-Modus erkennen sich selbst:
#   Key gesetzt   → echte KI
#   kein Key      → Mock-Daten (öffentliche Demo)
# LLM_PROVIDER muss man nur setzen, wenn man bewusst abweichen will.

# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GOOGLE_GENERATIVE_AI_API_KEY=

# Mock erzwingen, auch wenn ein Key da ist:
# FORCE_MOCK_ONLY=strict

# Öffentliche Demo (Render): Mock-Betrieb ohne Keys
FORCE_MOCK_ONLY=true
NEXT_PUBLIC_DEMO_MODE=true
INSIGHTS_MODE=mock

# Ohne API-Key lokal: Backend-LLM über die eingeloggte `claude` CLI (Abo/Credits).
# Voraussetzung: `claude` installiert & eingeloggt. Funktioniert nur lokal, nicht auf Render.
# LLM_PROVIDER=claude-cli
# LLM_MODEL=sonnet            # haiku (schnell) | sonnet | opus (stark)
# CLAUDE_CLI_PATH=            # falls `claude` nicht im PATH liegt
# CLAUDE_CLI_TIMEOUT_MS=120000

# Modell überschreiben (sonst sinnvoller Default pro Provider):
# ANTHROPIC_MODEL=claude-sonnet-4-20250514
# OPENAI_MODEL=gpt-4o-mini
# GEMINI_MODEL=gemini-2.0-flash

# =============================================================================
# Optional: Web-Recherche
# =============================================================================
# Ohne diese Keys arbeitet das LLM mit Allgemeinwissen weiter.
# „Gemini Research" / „Claude Research" in der UI nutzen deinen LLM-Key — kein zweites Modell.
# RESEARCH_WEB_PROVIDER=auto     # auto | firecrawl | perplexity | tavily | gemini | claude
# FIRECRAWL_API_KEY=
# PERPLEXITY_API_KEY=
# TAVILY_API_KEY=

# =============================================================================
# Optional: Referenz-Videos & Notion
# =============================================================================
# REFERENCE_PLATFORMS=youtube,instagram,tiktok,linkedin
# YOUTUBE_API_KEY=
# META_ACCESS_TOKEN=
# TIKTOK_ACCESS_TOKEN=
# LINKEDIN_ACCESS_TOKEN=

# NOTION_TOKEN=
# NOTION_DATABASE_ID=
