# --- LLM (wähle einen Provider) ---
# anthropic | gemini | openai
LLM_PROVIDER=anthropic
# Optional: Modell überschreiben (sonst Provider-Default)
# LLM_MODEL=

ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
# Alias:
# GEMINI_API_KEY=
OPENAI_API_KEY=

# --- Research (Web) ---
TAVILY_API_KEY=
PERPLEXITY_API_KEY=
FIRECRAWL_API_KEY=

# --- Referenz-Videos (Multi-Plattform) ---
# Komma-getrennt: youtube,instagram,tiktok,linkedin
REFERENCE_PLATFORMS=youtube,instagram,tiktok,linkedin

YOUTUBE_API_KEY=

# Meta / Instagram (Graph API)
META_ACCESS_TOKEN=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=

# TikTok
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_ACCESS_TOKEN=

# LinkedIn
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_ORGANIZATION_URN=

# --- Performance / Metriken ---
# mock = plattformspezifische Demo-Metriken (Default)
# live = API-Keys pro Plattform nutzen, sonst Fallback Mock
INSIGHTS_MODE=mock

# YouTube Analytics (optional, Live)
YOUTUBE_OAUTH_REFRESH_TOKEN=

# --- Notion ---
NOTION_TOKEN=
NOTION_DATABASE_ID=
